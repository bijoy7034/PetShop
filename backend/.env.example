MODE=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

MONGO_URI=mongodb://localhost:27017
DB_NAME=petshop
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# In prod set COOKIE_SECURE=true (requires HTTPS) and pin COOKIE_DOMAIN.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=petshop.yourdomain.com

# First-boot admin. If a user with ADMIN_EMAIL does not exist, the lifespan
# hook creates one with ADMIN_PASSWORD and forces a password change on first
# login. Leave empty in production once the account is provisioned.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# First-boot developer. Same shape as ADMIN_*. Developer is a
# universal-access role invisible to every other role — even admin
# can't view, patch, delete, or reset a developer account. Set once
# to seed the first developer; leave blank afterward so a restart
# can't create additional developers.
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=
DEVELOPER_NAME=

# ---- DB → R2 archive scheduler ----
# The scheduler ticks every 24 h. On each tick it runs the overdue-
# payment scan; a full DB dump uploads every DB_DUMP_INTERVAL_DAYS.
# Default is 1 (daily). Set 7 for weekly, 14 for bi-weekly, etc.
DB_DUMP_INTERVAL_DAYS=1
# Comma-separated collection names to skip. Default excludes only
# `sessions` (session tokens are ephemeral).
# DB_DUMP_EXCLUDE_COLLS=sessions
# Where inside the R2 bucket to write the tar.gz archives.
R2_ARCHIVE_PREFIX=db-archives

# ---- Cloudflare R2 (S3-compatible object store for product images) ----
# Account ID is public; find it at Cloudflare dashboard > R2 > Overview.
R2_ACCOUNT_ID=
# Endpoint is derived: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_BUCKET=pet-shop-products
# Create at Cloudflare dashboard > R2 > Manage API Tokens > Create Token
# (Object Read & Write). Shown ONCE at creation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Enable Public Access on the bucket; Cloudflare gives you a pub-<hash>.r2.dev
# URL. Paste it here (no trailing slash). Use a custom domain in production.
R2_PUBLIC_BASE_URL=
# Per-image size cap in bytes. Default 5 MB.
R2_MAX_IMAGE_BYTES=5242880
